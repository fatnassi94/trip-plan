# --- AI provider (free tier) ---
# Get a free key at https://aistudio.google.com/apikey — no credit card needed.
# Gemini's Flash models are free of charge for API use; Google may use
# free-tier traffic to improve their models, so don't send anything sensitive.
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Stable + free. Swap to gemini-3.8-flash (newest) or gemini-3.5-flash-lite
# (fastest/cheapest) any time — nothing else in the app changes.
GEMINI_MODEL=gemini-3.5-flash

# --- Database & auth (OPTIONAL) ---
# The app runs end to end on the Gemini key alone: trips generate and
# render, cached in the browser session. Add Supabase when you want trips
# to persist across reloads and belong to accounts.
# Free project at https://supabase.com; keys under Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
