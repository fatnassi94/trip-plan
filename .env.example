# --- AI provider (free tier) ---
# Get a free key at https://aistudio.google.com/apikey — no credit card needed.
# Gemini's Flash models are free of charge for API use; Google may use
# free-tier traffic to improve their models, so don't send anything sensitive.
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Free-tier quotas are small and PER MODEL — Google's own 429 quotes the
# number, and gemini-3.5-flash allows 20 requests a day, which one evening
# of testing will spend. Note that gemini-2.5-* is listed by the API but
# 404s for keys created recently ("no longer available to new users").
GEMINI_MODEL=gemini-3.6-flash
# Tried in order when the model above is out of quota or overloaded, so a
# spent daily allowance doesn't take trip generation down. Each model has
# its own quota bucket. Set to an empty value to use GEMINI_MODEL alone.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash

# --- Database & auth ---
# With NONE of these set, the app still runs end to end on the Gemini key
# alone: trips generate and render anonymously, cached in the browser
# session, and /unlock's paid-plan gate is skipped entirely.
#
# Set NEXT_PUBLIC_SUPABASE_URL + NEXT_PUBLIC_SUPABASE_ANON_KEY to turn on
# real sign-up/login (app/unlock, app/account) — trip generation then
# requires an account with an active plan, enforced server-side in
# app/api/trips/generate/route.ts, not just hidden in the UI.
# Also set SUPABASE_SERVICE_ROLE_KEY to persist generated trips so past
# trips show up on /account instead of only this browser tab's session.
# Free project at https://supabase.com; keys under Project Settings > API.
# Run supabase/schema.sql in the SQL editor once, for either piece.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Destination photography (optional) ---
# Free key at https://unsplash.com/developers (Demo app: 50 requests/hour).
# Server-side only — never prefix this with NEXT_PUBLIC_.
# Without it the app still runs: it falls back to any `curatedImages` URLs
# in data/destinations.json, then to designed gradient placeholders.
UNSPLASH_ACCESS_KEY=YPQ4cOuEDt3Dl_2fHvm52qi1A_tmuaZowsiCnikP_9M
# auto (default) = Unsplash then curated; curated = skip Unsplash;
# off = no external images at all (used by the e2e suite).
TRAVEL_IMAGES_MODE=auto
