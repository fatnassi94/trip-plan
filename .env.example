# --- AI provider (free tier) ---
# Get a free key at https://aistudio.google.com/apikey — no credit card needed.
# Gemini's Flash models are free of charge for API use; Google may use
# free-tier traffic to improve their models, so don't send anything sensitive.
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Stable + free. Swap to gemini-3.8-flash (newest) or gemini-3.5-flash-lite
# (fastest/cheapest) any time — nothing else in the app changes.
GEMINI_MODEL=gemini-3.5-flash

# --- Database & auth ---
# With NONE of these set, the app still runs end to end on the Gemini key
# alone: trips generate and render anonymously, cached in the browser
# session, and /unlock's paid-plan gate is skipped entirely.
#
# Set NEXT_PUBLIC_SUPABASE_URL + NEXT_PUBLIC_SUPABASE_ANON_KEY to turn on
# real sign-up/login (app/unlock, app/account) — trip generation then
# requires an account with an active plan, enforced server-side in
# app/api/trips/generate/route.ts, not just hidden in the UI.
# Also set SUPABASE_SERVICE_ROLE_KEY to persist generated trips so past
# trips show up on /account instead of only this browser tab's session.
# Free project at https://supabase.com; keys under Project Settings > API.
# Run supabase/schema.sql in the SQL editor once, for either piece.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
